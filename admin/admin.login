<!DOCTYPE html>
<html lang="fil">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>
Dalubwikaan Admin Login
</title>


<link rel="stylesheet" href="css/admin.css">


</head>


<body>



<div class="login-container">


<div class="login-box">


<h1>
DALUBWIKAAN
</h1>


<p>
Admin Portal
</p>



<input 
type="email"
id="email"
placeholder="Email Address">



<input 
type="password"
id="password"
placeholder="Password">



<button id="loginBtn">

Login

</button>



<p id="message"></p>



</div>


</div>




<script type="module" src="js/auth.js"></script>


</body>


</html>
